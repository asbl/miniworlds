#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_corner:5 of
msgid "Corner direction, e.g. `\"no\"`."
msgstr "Eckenrichtung, z. B. `\"no\"`."

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_distance_to:1 of
msgid "Return the hex distance (number of steps) to a tile, position, or actor."
msgstr ""
"Gibt den Hex-Abstand (Anzahl der Schritte) zu einer Kachel, Position oder"
" einem Actor zurück."

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_edge:1 of
msgid "Return the edge of this hex in the given direction."
msgstr "Gibt die Kante dieses Hexfelds in der angegebenen Richtung zurück."

#: miniworlds.worlds.hex_world.hex_edge.HexEdge.from_position:4
#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_edge:3 of
