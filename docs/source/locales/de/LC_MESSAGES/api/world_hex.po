msgstr ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`\\~miniworlds.worlds.hex\\_world.hex\\_edge.HexEdge\\``"

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_edge:5 of
msgid "Edge direction, e.g. `\"o\"`."
msgstr "Kantenrichtung, z. B. `\"o\"`."

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_local_center_coordinate:1
#: of
msgid "Returns the center point offset for a tile, in local pixel coordinates."
msgstr ""
"Gibt den Mittelpunkt-Versatz einer Kachel in lokalen Pixelkoordinaten "
"zurück."

