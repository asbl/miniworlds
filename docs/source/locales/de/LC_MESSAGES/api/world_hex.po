msgstr ""
":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`\\~typing.List\\`\\\\ "
"\\\\\\[\\:py\\:class\\:\\`\\~miniworlds.worlds.hex\\_world.hex\\_corner.HexCorner\\`\\]`"

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_neighbour_edges:1 of
msgid "Return the six edges of this hex, clockwise from the north-east edge."
msgstr ""
"Gibt die sechs Kanten dieses Hexfelds zurück, im Uhrzeigersinn ab der "
"Nordost-Kante."

#: miniworlds.worlds.hex_world.hex_corner.HexCorner.get_neighbour_edges:5
#: miniworlds.worlds.hex_world.hex_edge.HexEdge.get_neighbour_edges:6
