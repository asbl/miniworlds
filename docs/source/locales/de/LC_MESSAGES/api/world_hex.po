#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_neighbour:1 of
msgid "Return the neighboring hex in one direction, or `None` at the border."
msgstr ""
"Gibt das benachbarte Hexfeld in einer Richtung zurück, oder `None` am "
"Rand."

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_neighbour:3 of
msgid ""
":sphinx_autodoc_typehints_type:`\\:py\\:data\\:\\`\\~typing.Optional\\`\\\\"
" "
