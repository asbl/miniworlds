#: miniworlds.worlds.hex_world.hex_coords.nearest_axis_degrees:1 of
msgid "Return the hex axis degree nearest to `direction` (scratch-style degrees)."
msgstr ""

#: miniworlds.worlds.hex_world.hex_coords.nearest_axis_degrees:3 of
msgid ""
"The six hex axes are 30, 90, 150, 210, 270 and 330 degrees (0 = up, "
"clockwise). Any other angle is snapped to the nearest axis, so one "
"movement step is always exactly one hex. Ties round towards the next "
"higher axis."
msgstr ""

