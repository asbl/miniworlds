msgstr ""
":sphinx_autodoc_typehints_type:`\\:py\\:data\\:\\`\\~typing.Optional\\`\\\\"
" "
"\\\\\\[\\:py\\:class\\:\\`\\~miniworlds.worlds.hex\\_world.hex\\_tile.HexTile\\`\\]`"

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_neighbour:5 of
msgid "One of `\"o\"`, `\"so\"`, `\"sw\"`, `\"w\"`, `\"nw\"`, `\"no\"`."
msgstr "Eine von `\"o\"`, `\"so\"`, `\"sw\"`, `\"w\"`, `\"nw\"`, `\"no\"`."

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_neighbour:7 of
msgid "If `direction` is not a hex direction."
msgstr "Wenn `direction` keine Hex-Richtung ist."

#: miniworlds.worlds.hex_world.hex_tile.HexTile.get_neighbour_corners:1 of
msgid "Return the six corners of this hex, clockwise from the top tip."
msgstr ""
"Gibt die sechs Ecken dieses Hexfelds zurück, im Uhrzeigersinn ab der "
"oberen Spitze."

#: miniworlds.worlds.hex_world.hex_corner.HexCorner.get_neighbour_corners:7
#: miniworlds.worlds.hex_world.hex_edge.HexEdge.get_neighbour_corners:3
